# Example secret manifest - DO NOT COMMIT ACTUAL SECRETS TO GIT
apiVersion: v1
kind: Secret
metadata:
  name: rbtc-faucet-secrets
  namespace: rbtc-faucet-${ENVIRONMENT}
  labels:
    app: rbtc-faucet
    environment: ${ENVIRONMENT}
type: Opaque
data:
  # Base64 encoded secrets
  # Example:
  # DATABASE_URL: <base64-encoded-database-url>
  # API_KEY: <base64-encoded-api-key>
  
# To create secrets from command line:
# kubectl create secret generic rbtc-faucet-secrets \
#   --from-literal=DATABASE_URL="your-database-url" \
#   --from-literal=API_KEY="your-api-key" \
#   --namespace=rbtc-faucet-dev
